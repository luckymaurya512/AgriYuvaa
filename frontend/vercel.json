{
  "rewrites": [
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|twitterbot|Twitterbot|LinkedInBot|linkedinbot|TelegramBot|telegrambot|Discordbot|slackbot).*"
        }
      ],
      "destination": "https://agriyuvaa.onrender.com/api/blogs/share/:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
