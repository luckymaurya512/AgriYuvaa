PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/agriyuvaa

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (resumes, logos, profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AgriYuvaa <no-reply@agriyuvaa.com>"

# Frontend URL (for CORS + email links)
CLIENT_URL=http://localhost:5173

# Super Admin bootstrap (used by seed script)
SUPERADMIN_NAME="AgriYuvaa Super Admin"
SUPERADMIN_EMAIL=superadmin@agriyuvaa.com
SUPERADMIN_PASSWORD=ChangeThisPassword123!
